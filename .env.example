# ==============================================================================
# ELECTRA SOLAR - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate the values for production or local development.
# IMPORTANT: Never commit .env.local or production secrets to Git.

# --- Domain & Deployment ---
NEXT_PUBLIC_SITE_URL=https://electrasolar.in

# --- Business Contact & Messaging Defaults ---
NEXT_PUBLIC_PHONE_PRIMARY=+919822407189
NEXT_PUBLIC_PHONE_SECONDARY=+919373336340
NEXT_PUBLIC_EMAIL_PRIMARY=contact@electrasolar.in
NEXT_PUBLIC_WHATSAPP_NUMBER=919822407189

# --- Analytics & Search Console ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token

# --- Server-Side Enquiry Notifications (Resend / SMTP) ---
# Resend API Key for dispatching instant quote alerts to Electra sales desk
RESEND_API_KEY=re_123456789_abcdef
ENQUIRY_NOTIFICATION_TO_EMAIL=sales@electrasolar.in
ENQUIRY_NOTIFICATION_FROM_EMAIL=enquiries@electrasolar.in

# --- Optional CMS / Database Layer (Supabase PostgreSQL & Storage) ---
# Configured for future Phase 2 multi-distributor CMS or dynamic enquiry archive
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
